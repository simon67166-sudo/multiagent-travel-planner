LLM_BASE_URL=https://llmapi.paratera.com/v1
LLM_API_KEY=
LLM_MODEL_PRO=DeepSeek-V4-Pro-0813
LLM_MODEL_FLASH=DeepSeek-V4-Flash-0731
# 旧的 PARATERA_API_KEY 变量名也兼容
# 地图相关（行程地图 + 港澳附近游）只用高德，没有 OSM 备援
AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# 灾害预警（exception_agent.check_weather 用），去 https://dev.qweather.com 申请 API KEY
# QWEATHER_API_HOST 是账号专属域名（控制台"项目管理"能看到），不用带 https:// 前缀
QWEATHER_KEY=
QWEATHER_API_HOST=
# 可选，绝对路径；不传默认 orchestrator/data/sessions.db
# TRAVEL_DB_PATH=E:/multiagent-travel-planner/orchestrator/data/sessions.db
